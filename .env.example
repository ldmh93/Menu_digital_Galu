# Copia este archivo como .env.local y cambia los valores.

# Contrasenia para entrar al panel de /admin.
ADMIN_PASSWORD=cambia-esta-contrasenia

# Cadena larga y aleatoria con la que se firma la cookie de sesion.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=cambia-este-secreto
